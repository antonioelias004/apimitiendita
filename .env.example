# Copia este archivo como .env y rellena los valores reales.
# El archivo .env NUNCA se sube al repositorio.

# Cadena de conexion de MongoDB Atlas
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@TU-CLUSTER.mongodb.net/TiendaDB

# Clave para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# Puerto local (en Vercel se asigna automaticamente)
PORT=3000
